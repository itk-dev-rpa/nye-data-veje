# EditorConfig hjælper IDE’er med konsistente regler på tværs af udviklere
# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.py]
# Python-kode
indent_size = 4

[*.sql]
# SQL scripts: hold 4-space indrykning
indent_size = 4

[*.md]
# Behold bevidst trailing spaces i Markdown (linjeskift)
trim_trailing_whitespace = false

[*.yml]
indent_size = 2

[*.json]
indent_size = 2
